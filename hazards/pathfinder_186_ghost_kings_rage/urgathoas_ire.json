            "edition": "remastered",
            "game-id": "974c2ceb862b6781b4ebac590bd83913",
            "game-obj": "Traits",
            "name": "Fire",
            "sources": [
              {
                "errata": {
                  "alt": "2.0",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "2.0",
                  "type": "link"
