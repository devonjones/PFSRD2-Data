        "effect": "Four pillars (see above) manifest a writhing whip composed of solidified shadows. The trap then rolls initiative.",
        "name": "Manifest",
        "subtype": "ability",
        "traits": [
          {
            "alternate_link": {
              "alternate_type": "legacy",
              "aonid": 11,
