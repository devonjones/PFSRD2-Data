            },
            "edition": "remastered",
            "game-id": "6a30ff50ed821ab5b9699b2f3d68c0d6",
            "game-obj": "Traits",
            "name": "Arcane",
            "sources": [
              {
                "errata": {
                  "alt": "2.0",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "2.0",
                  "type": "link"
                },
                "link": {
                  "alt": "Player Core pg. 452",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "Player Core pg. 452",
                  "type": "link"
                },
                "name": "Player Core",
                "page": 452,
                "type": "source"
              }
            ],
            "text": "This magic comes from the arcane tradition, which is built on logic and rationality. Anything with this trait is magical.  \n  \nA creature with this trait is primarily constituted of or has a strong connection to arcane magic.",
            "type": "trait"
          },
          {
            "edition": "legacy",
            "game-id": "9011037bb4a11ca6cf2d16fa8a657bf5",
            "game-obj": "Traits",
            "links": [
              {
                "alt": "summoning",
                "aonid": 154,
                "game-obj": "Traits",
                "name": "summoning",
                "type": "link"
              },
              {
                "alt": "teleportation",
                "aonid": 156,
                "game-obj": "Traits",
                "name": "teleportation",
                "type": "link"
              }
            ],
            "name": "Conjuration",
            "sources": [
              {
                "errata": {
                  "alt": "4.0",
                  "aonid": 1,
                  "game-obj": "Sources",
                  "name": "4.0",
                  "type": "link"
                },
                "link": {
                  "alt": "Core Rulebook pg. 630",
                  "aonid": 1,
                  "game-obj": "Sources",
                  "name": "Core Rulebook pg. 630",
                  "type": "link"
                },
                "name": "Core Rulebook",
                "page": 630,
                "type": "source"
              }
            ],
            "text": "Effects and magic items with this trait are associated with the conjuration school of magic, typically involving summoning, creation, teleportation, or moving things from place to place.",
            "type": "trait"
          },
          {
            "alternate_link": {
              "alternate_type": "legacy",
              "aonid": 143,
              "game-obj": "Traits",
              "type": "alternate_link"
            },
            "edition": "remastered",
            "game-id": "83242b57548e68270396486e2a540b6b",
            "game-obj": "Traits",
            "name": "Shadow",
            "sources": [
              {
                "errata": {
                  "alt": "2.0",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "2.0",
                  "type": "link"
                },
                "link": {
                  "alt": "Player Core pg. 460",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "Player Core pg. 460",
                  "type": "link"
                },
                "name": "Player Core",
                "page": 460,
                "type": "source"
              }
            ],
            "text": "Magic with this trait involves shadows or the energy of the Netherworld.  \n  \n Planes with this trait are umbral with murky light. In the Netherworld, the radius of all light from light sources and the areas of light spells are halved.",
            "type": "trait"
          }
        ],
        "trigger": "A creature other than Kemnebi enters the chamber",
        "type": "stat_block_section"
      },
      {
        "ability_type": "ability",
        "action_type": {
          "name": "One Action",
