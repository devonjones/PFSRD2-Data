        "name": "Scream",
        "subtype": "ability",
        "traits": [
          {
            "edition": "legacy",
            "game-id": "01bf3e53d6c0fc7f70419341635bfe8f",
            "game-obj": "Traits",
            "name": "Evocation",
            "sources": [
              {
                "errata": {
