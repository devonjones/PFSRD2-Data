        ],
        "name": "Electrify",
        "subtype": "ability",
        "text": "The metal vault crackles with electricity. In air, this would damage only creatures touching it; in water, the trap deals 2d8 electricity damage to all creatures in a 10-foot emanation (DC 25 basic Fortitude save).",
        "type": "stat_block_section"
      },
      {
        "ability_type": "ability",
        "action_type": {
          "name": "One Action",
          "subtype": "action_type",
          "type": "stat_block_section"
        },
        "name": "Launch Darts",
        "subtype": "ability",
        "text": "The vault fires a stream of poisoned darts. The trap attacks all creatures in a 30-foot line with its poison dart spray Strike; roll 1d8 to determine the line's direction. These Strikes don't have a multiple attack penalty.",
        "type": "stat_block_section"
      },
      {
        "ability_type": "ability",
        "action_type": {
          "name": "One Action",
          "subtype": "action_type",
          "type": "stat_block_section"
        },
        "name": "Spin",
        "subtype": "ability",
        "text": "The vault spins quickly for 1 round. While it Spins, checks to disable the trap have a \u20132 circumstance penalty, and it Launches Darts at all creatures within 30 feet of it, rather than in a line.",
        "type": "stat_block_section"
      },
      {
        "ability_type": "ability",
