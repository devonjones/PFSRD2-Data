                "name": "Player Core",
                "page": 454,
                "type": "source"
              }
            ],
            "text": "An effect with the death trait kills you immediately if it reduces you to 0 HP. Some death effects can bring you closer to death or slay you outright without reducing you to 0 HP.",
            "type": "trait"
          },
          {
            "alternate_link": {
              "alternate_type": "legacy",
              "aonid": 60,
              "game-obj": "Traits",
              "type": "alternate_link"
            },
            "edition": "remastered",
            "game-id": "fb5f8b3d849b073e1514a6a025810470",
            "game-obj": "Traits",
            "name": "Emotion",
