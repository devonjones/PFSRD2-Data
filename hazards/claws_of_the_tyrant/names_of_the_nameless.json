        "name": "Uncommon",
        "sources": [
          {
            "errata": {
              "alt": "2.0",
              "aonid": 216,
              "game-obj": "Sources",
              "name": "2.0",
              "type": "link"
            },
            "link": {
              "alt": "Player Core pg. 11",
              "aonid": 216,
              "game-obj": "Sources",
              "name": "Player Core pg. 11",
              "type": "link"
            },
            "name": "Player Core",
            "page": 11,
            "type": "source"
          }
        ],
        "text": "Something of uncommon rarity requires special training or comes from a particular culture or part of the world. Some character choices give access to uncommon options, and the GM can choose to allow access for anyone. Less is known about uncommon creatures than common creatures. They typically can't be summoned. The DC of Recall Knowledge checks related to these creature is increased by 2.",
        "type": "trait"
      },
      {
        "edition": "legacy",
        "game-id": "5eeb16730fc7f7d6a6aa2ed20d329a2b",
        "game-obj": "Traits",
        "name": "Complex",
        "sources": [
          {
            "errata": {
              "alt": "4.0",
              "aonid": 1,
              "game-obj": "Sources",
              "name": "4.0",
              "type": "link"
            },
            "link": {
              "alt": "Core Rulebook pg. 629",
              "aonid": 1,
              "game-obj": "Sources",
              "name": "Core Rulebook pg. 629",
              "type": "link"
            },
            "name": "Core Rulebook",
            "page": 629,
            "type": "source"
          }
        ],
        "text": "A hazard with this trait takes turns in an encounter.",
        "type": "trait"
      },
      {
        "alternate_link": {
