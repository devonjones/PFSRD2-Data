            "link": {
              "alt": "GM Core pg. 330",
              "aonid": 218,
              "game-obj": "Sources",
              "name": "GM Core pg. 330",
              "type": "link"
            },
            "name": "GM Core",
            "page": 330,
            "type": "source"
          }
        ],
        "text": "A hazard with this trait is a spiritual echo, often of someone with a tragic death. Putting a haunt to rest often involves resolving the haunt\u2019s unfinished business. A haunt that hasn\u2019t been properly put to rest always returns after a time.",
        "type": "trait"
      }
