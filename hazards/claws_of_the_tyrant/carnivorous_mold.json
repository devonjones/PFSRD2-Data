        ],
        "name": "Flesh-Eating Spores",
        "stages": [
          {
            "name": "Stage 1",
            "subtype": "affliction_stage",
            "text": "4d10 void damage and drained 1 (1 round)",
            "type": "stat_block_section"
          },
          {
