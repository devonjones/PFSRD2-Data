            "type": "stat_block_section"
          }
        ],
        "subtype": "ability",
        "text": "The flesh-eating spores leave red rings on the skin as they dissolve the target\u2019s flesh;",
        "traits": [
          {
            "alternate_link": {
              "alternate_type": "legacy",
              "aonid": 37,
