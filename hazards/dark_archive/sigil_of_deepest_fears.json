            "alternate_link": {
              "alternate_type": "legacy",
              "aonid": 40,
              "game-obj": "Traits",
              "type": "alternate_link"
            },
            "edition": "remastered",
            "game-id": "74fd4b78b1a679acb12014cc5bd3ccf6",
            "game-obj": "Traits",
            "name": "Death",
            "sources": [
              {
                "errata": {
                  "alt": "2.0",
                  "aonid": 216,
                  "game-obj": "Sources",
                  "name": "2.0",
                  "type": "link"
                },
                "link": {
