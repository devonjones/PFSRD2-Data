            "name": "knocked back",
            "type": "link"
          },
          {
            "alt": "cleanse affliction",
            "aonid": 1467,
            "game-obj": "Spells",
            "name": "cleanse affliction",
            "type": "link"
          }
        ],
        "name": "Curse Trespassers",
        "subtype": "ability",
        "traits": [
