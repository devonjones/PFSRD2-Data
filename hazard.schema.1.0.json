    "attack_bonus": {
      "additionalProperties": false,
      "properties": {
        "bonuses": {
          "additionalItems": false,
          "description": "Attack bonuses as published. creature.schema.json requires exactly 3 because a creature stat block prints its full multiple-attack progression (\"+16 [+12/+8]\"); no hazard does. All 128 published hazard attack lines carry a single bonus and no MAP bracket, whether the hazard is Simple or Complex, so this is bounded to exactly 1 — a hazard that ever prints a progression should fail here rather than pass unnoticed. That is a printing convention, not an exemption: a complex hazard acts each round through its routine, so repeated Strikes take the multiple attack penalty, and 27 attack lines say \"no multiple attack penalty\" explicitly precisely because it would otherwise apply. Consumers derive the progression from the rules; this field reports only what the source printed.",
          "items": {
            "type": "integer"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "link": {
          "$ref": "#/definitions/link"
        },
        "subtype": {
          "enum": [
            "attack_bonus"
          ]
        },
        "type": {
          "enum": [
            "stat_block_section"
          ]
        }
      },
      "required": [
        "type",
        "subtype",
        "bonuses"
      ],
      "type": "object"
    },
